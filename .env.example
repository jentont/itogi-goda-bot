# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# Твой Telegram id (и других админов через запятую) — им доступна /admin
ADMIN_IDS=123456789

# Адрес мини-аппа, обязательно https (домен/поддомен на твоём сервере через nginx)
PUBLIC_URL=https://itogi.example.com

# Где слушает сам бот; nginx проксирует сюда
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Подводим итоги этого года
YEAR=2026

# Закрытый канал для карточек (бот — админ). Нужен, чтобы инлайн-карточки
# открывались мгновенно через file_id. Можно оставить 0.
STORAGE_CHAT_ID=0

# Сколько секунд верить проверке подписки
SUBSCRIBE_TTL=600

# Кнопки «Наш канал» и «Реклама» в меню (можно пусто)
PROJECT_CHANNEL=
ADS_CONTACT=

# Премиум-эмодзи (работают только если у бота юзернейм с Fragment)
PREMIUM_EMOJI_ON=1
EMOJI_PACK=

# Час суточного отчёта по спонсорам (Москва)
REPORT_HOUR=21

# PostgreSQL (раздел «Базы данных» на хостинге). Задано — данные хранятся там
# и не пропадают при пересборке. Пусто — файл SQLite в data/ (для локального запуска)
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ
DATABASE_URL=
